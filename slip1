import random

def objective_function(x):
    return -x**2 + 4*x

def hill_climbing(starting_point, step_size, max_iterations):
    current_point = starting_point
    current_value = objective_function(current_point)
    
    for _ in range(max_iterations):
        neighbor1 = current_point + step_size
        neighbor2 = current_point - step_size
        
        neighbor1_value = objective_function(neighbor1)
        neighbor2_value = objective_function(neighbor2)
        
        if neighbor1_value > current_value:
            current_point = neighbor1
            current_value = neighbor1_value
        elif neighbor2_value > current_value:
            current_point = neighbor2
            current_value = neighbor2_value
        else:
            print(f"Local maximum found at x = {current_point}, f(x) = {current_value}")
            break
    
    return current_point, current_value

starting_point = random.uniform(-10, 10)  
step_size = 0.1  # Step size for the search
max_iterations = 100  # Maximum number of iterations

max_point, max_value = hill_climbing(starting_point, step_size, max_iterations)

print(f"Maximum found at x = {max_point}, f(x) = {max_value}")




