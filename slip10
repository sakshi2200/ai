# Solve TWO + TWO = FOUR (cryptarithmetic) by brute force
from itertools import permutations

def solve_cryptarithm():
    letters = ('T','W','O','F','U','R')
    digits = '0123456789'
    solutions = []
    for perm in permutations(digits, len(letters)):
        mapping = dict(zip(letters, perm))
        # Leading letters cannot be '0'
        if mapping['T'] == '0' or mapping['F'] == '0':
            continue
        # Construct numbers
        TWO = int(mapping['T'] + mapping['W'] + mapping['O'])
        FOUR = int(mapping['F'] + mapping['O'] + mapping['U'] + mapping['R'])
        # Check equation TWO + TWO = FOUR
        if TWO + TWO == FOUR:
            solutions.append((mapping, TWO, FOUR))
    return solutions

if __name__ == "__main__":
    solutions = solve_cryptarithm()
    if not solutions:
        print("No solutions found.")
    else:
        print(f"Found {len(solutions)} solution(s):\n")
        for mapping, TWO, FOUR in solutions:
            print("Mapping:")
            for letter in sorted(mapping):
                print(f"  {letter} -> {mapping[letter]}")
            print(f"  {TWO} + {TWO} = {FOUR}\n")




