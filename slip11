def means_ends_analysis(start, goal):
    i, j = 0, 0
    steps = []

    while i < len(start) or j < len(goal):

        # Case 1: characters match → move ahead
        if i < len(start) and j < len(goal) and start[i] == goal[j]:
            steps.append(f"Match '{start[i]}'")
            i += 1
            j += 1

        # Case 2: Replace when both exist but differ
        elif i < len(start) and j < len(goal) and start[i] != goal[j]:
            steps.append(f"Replace '{start[i]}' with '{goal[j]}'")
            start = start[:i] + goal[j] + start[i+1:]
            i += 1
            j += 1

        # Case 3: Insert character (goal has extra character)
        elif j < len(goal) and (i >= len(start) or start[i] != goal[j]):
            steps.append(f"Insert '{goal[j]}' at position {i}")
            start = start[:i] + goal[j] + start[i:]
            i += 1
            j += 1

        # Case 4: Delete extra character in start
        elif i < len(start):
            steps.append(f"Delete '{start[i]}' from position {i}")
            start = start[:i] + start[i+1:]

    return steps


# Main program
start_str = input("Enter the starting string (lowercase): ")
goal_str = input("Enter the goal string (lowercase): ")

print("\nSteps using Means–Ends Analysis:\n")
steps = means_ends_analysis(start_str, goal_str)

for step in steps:
    print(step)

print("\nTransformation complete!")



