from collections import deque

jug1_capacity = 4  
jug2_capacity = 3  
target = 2        
initial_state = (0, 0)
def bfs_water_jug():
    queue = deque([initial_state])
    visited = set()  
    visited.add(initial_state)

    while queue:
        jug1, jug2 = queue.popleft()
        print(f"Current state: Jug1: {jug1} gallons, Jug2: {jug2} gallons")
        if jug2 == target:
            print("Goal reached! 2 gallons in the 3-gallon jug.")
            return True

       
        next_states = []

       
        next_states.append((jug1_capacity, jug2))
       
        next_states.append((jug1, jug2_capacity))
       
        next_states.append((0, jug2))
        
        next_states.append((jug1, 0))
     
        transfer = min(jug1, jug2_capacity - jug2)
        next_states.append((jug1 - transfer, jug2 + transfer))
  
        transfer = min(jug2, jug1_capacity - jug1)
        next_states.append((jug1 + transfer, jug2 - transfer))

       
        for state in next_states:
            if state not in visited:
                visited.add(state)
                queue.append(state)

    print("No solution found.")
    return False


bfs_water_jug()


