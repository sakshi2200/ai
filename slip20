class CollegeBot:
    def __init__(self):
        # Initialize the bot with some basic information
        self.info = {
            'name': 'John Doe',
            'major': 'Computer Science',
            'year': 'Sophomore',
            'gpa': '3.8',
            'courses': ['Data Structures', 'Algorithms', 'Web Development', 'Database Systems'],
            'email': 'johndoe@college.edu',
            'clubs': ['Coding Club', 'Robotics Club'],
            'office_hours': 'Monday and Wednesday 2-4 PM',
            'favorite_subject': 'Algorithms'
        }

    def get_info(self, query):
        query = query.lower()
        responses = {
            'name': f"My name is {self.info['name']}.",
            'major': f"I am majoring in {self.info['major']}.",
            'year': f"I am a {self.info['year']}.",
            'gpa': f"My GPA is {self.info['gpa']}.",
            'courses': f"I am currently taking the following courses: {', '.join(self.info['courses'])}.",
            'email': f"You can reach me at {self.info['email']}.",
            'clubs': f"I am a member of the following clubs: {', '.join(self.info['clubs'])}.",
            'office hours': f"My office hours are {self.info['office_hours']}.",
            'favorite subject': f"My favorite subject is {self.info['favorite_subject']}.",
        }

        # Provide a response based on the query
        for key in responses:
            if key in query:
                return responses[key]
        
        return "Sorry, I don't have information on that topic."

def main():
    bot = CollegeBot()
    print("Welcome to the College Bot! Ask me about college-related information.")
    while True:
        user_input = input("You: ")
        if user_input.lower() in ['exit', 'quit', 'bye']:
            print("College Bot: Goodbye!")
            break
        response = bot.get_info(user_input)
        print(f"College Bot: {response}")

if __name__ == "__main__":
    main()
















