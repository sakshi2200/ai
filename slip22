import math

# Alpha-Beta Pruning function
def alpha_beta_pruning(depth, nodeIndex, isMax, values, alpha, beta):
    # If leaf node is reached, return value
    if depth == 3:
        return values[nodeIndex]

    if isMax:
        best = -math.inf
        
        # Recur for left and right children
        for i in range(2):
            val = alpha_beta_pruning(depth + 1,
                                     nodeIndex * 2 + i,
                                     False,
                                     values,
                                     alpha,
                                     beta)
            best = max(best, val)
            alpha = max(alpha, best)

            # Pruning step
            if beta <= alpha:
                break
        return best

    else:   # Minimizer
        best = math.inf
        
        for i in range(2):
            val = alpha_beta_pruning(depth + 1,
                                     nodeIndex * 2 + i,
                                     True,
                                     values,
                                     alpha,
                                     beta)
            best = min(best, val)
            beta = min(beta, best)

            # Pruning step
            if beta <= alpha:
                break
        return best


# ------------ MAIN PROGRAM ------------

# Example leaf node values for a complete binary tree
values = [3, 5, 6, 9, 1, 2, 0, -1]

print("Leaf node values:", values)
print("\nResult of Alpha-Beta Pruning:")

result = alpha_beta_pruning(0, 0, True, values, -math.inf, math.inf)
print("Optimal value:", result)










