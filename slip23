# Cryptarithm: SEND + MORE = MONEY
# Letters involved: S, E, N, D, M, O, R, Y

from itertools import permutations

def solve_send_more_money():
    letters = ('S','E','N','D','M','O','R','Y')
    digits = '0123456789'
    solutions = []

    for perm in permutations(digits, len(letters)):
        m = dict(zip(letters, perm))

        # Leading letters cannot be zero
        if m['S'] == '0' or m['M'] == '0':
            continue

        SEND  = int(m['S'] + m['E'] + m['N'] + m['D'])
        MORE  = int(m['M'] + m['O'] + m['R'] + m['E'])
        MONEY = int(m['M'] + m['O'] + m['N'] + m['E'] + m['Y'])

        if SEND + MORE == MONEY:
            solutions.append((m, SEND, MORE, MONEY))

    return solutions


# Run solver
solutions = solve_send_more_money()

if not solutions:
    print("No solutions found.")
else:
    print(f"Found {len(solutions)} solution(s):\n")
    for m, SEND, MORE, MONEY in solutions:
        print("Mapping:")
        for k in sorted(m):
            print(f"  {k} -> {m[k]}")
        print(f"\n  {SEND} + {MORE} = {MONEY}\n")

