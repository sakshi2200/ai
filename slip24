# Cryptarithm: CROSS + ROADS = DANGER
# Letters: C R O S A D N G E

from itertools import permutations

def solve_cross_roads():
    letters = ('C','R','O','S','A','D','N','G','E')
    digits = '0123456789'
    solutions = []

    for perm in permutations(digits, len(letters)):
        m = dict(zip(letters, perm))

        # Leading letters cannot be zero
        if m['C'] == '0' or m['R'] == '0' or m['D'] == '0':
            continue

        CROSS = int(m['C'] + m['R'] + m['O'] + m['S'] + m['S'])
        ROADS = int(m['R'] + m['O'] + m['A'] + m['D'] + m['S'])
        DANGER = int(m['D'] + m['A'] + m['N'] + m['G'] + m['E'] + m['R'])

        if CROSS + ROADS == DANGER:
            solutions.append((m, CROSS, ROADS, DANGER))

    return solutions


# Run solver
solutions = solve_cross_roads()

if not solutions:
    print("No solutions found.")
else:
    print(f"Found {len(solutions)} solution(s):\n")
    for m, CROSS, ROADS, DANGER in solutions:
        print("Mapping:")
        for k in sorted(m):
            print(f"  {k} -> {m[k]}")
        print(f"\n  {CROSS} + {ROADS} = {DANGER}\n")
