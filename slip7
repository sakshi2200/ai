q1

import math

PLAYER_X = 'X'
PLAYER_O = 'O'
EMPTY = ' '

def initialize_board():
    return [[EMPTY for _ in range(3)] for _ in range(3)]

def print_board(board):
    for row in board:
        print(" | ".join(row))
        print("-" * 5)

def check_win(board, player):
    win_conditions = [
        # Rows
        [(0, 0), (0, 1), (0, 2)],
        [(1, 0), (1, 1), (1, 2)],
        [(2, 0), (2, 1), (2, 2)],
        # Columns
        [(0, 0), (1, 0), (2, 0)],
        [(0, 1), (1, 1), (2, 1)],
        [(0, 2), (1, 2), (2, 2)],
        # Diagonals
        [(0, 0), (1, 1), (2, 2)],
        [(0, 2), (1, 1), (2, 0)]
    ]
    return any(all(board[r][c] == player for r, c in condition) for condition in win_conditions)

def is_full(board):
    return all(cell != EMPTY for row in board for cell in row)

def get_empty_positions(board):
    return [(r, c) for r in range(3) for c in range(3) if board[r][c] == EMPTY]


def minimax(board, depth, alpha, beta, is_maximizing):
    if check_win(board, PLAYER_X):
        return 10 - depth
    if check_win(board, PLAYER_O):
        return depth - 10
    if is_full(board):
        return 0

    if is_maximizing:  
        max_eval = -math.inf
        for r, c in get_empty_positions(board):
            board[r][c] = PLAYER_O
            eval = minimax(board, depth + 1, alpha, beta, False)
            board[r][c] = EMPTY
            max_eval = max(max_eval, eval)
            alpha = max(alpha, eval)
            if beta <= alpha:
                break
        return max_eval
    else:  # Human tries to minimize O's win
        min_eval = math.inf
        for r, c in get_empty_positions(board):
            board[r][c] = PLAYER_X
            eval = minimax(board, depth + 1, alpha, beta, True)
            board[r][c] = EMPTY
            min_eval = min(min_eval, eval)
            beta = min(beta, eval)
            if beta <= alpha:
                break
        return min_eval


def find_best_move(board, player):
    best_move = None
    if player == PLAYER_O:
        best_value = -math.inf
        for r, c in get_empty_positions(board):
            board[r][c] = PLAYER_O
            move_value = minimax(board, 0, -math.inf, math.inf, False)
            board[r][c] = EMPTY
            if move_value > best_value:
                best_value = move_value
                best_move = (r, c)
    else:
        best_value = math.inf
        for r, c in get_empty_positions(board):
            board[r][c] = PLAYER_X
            move_value = minimax(board, 0, -math.inf, math.inf, True)
            board[r][c] = EMPTY
            if move_value < best_value:
                best_value = move_value
                best_move = (r, c)
    return best_move

# Human vs Computer game
def play_game():
    board = initialize_board()
    current_player = PLAYER_X  # Human starts

    while True:
        print_board(board)

        if current_player == PLAYER_X:
            print("Player X's turn (You)")
            while True:
                try:
                    r, c = map(int, input("Enter your move (row and column 0-2): ").split())
                    if board[r][c] == EMPTY:
                        board[r][c] = PLAYER_X
                        break
                    else:
                        print("Position already taken. Try again.")
                except:
                    print("Invalid input. Try again.")
        else:
            print("Player O's turn (Computer)")
            r, c = find_best_move(board, PLAYER_O)
            board[r][c] = PLAYER_O

        if check_win(board, PLAYER_X):
            print_board(board)
            print("Player X wins!")
            break

        if check_win(board, PLAYER_O):
            print_board(board)
            print("Player O wins!")
            break

        if is_full(board):
            print_board(board)
            print("It's a draw!")
            break

        current_player = PLAYER_O if current_player == PLAYER_X else PLAYER_X


if __name__ == "__main__":
    play_game()




